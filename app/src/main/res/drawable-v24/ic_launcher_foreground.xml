<?xml version="1.0" encoding="utf-8"?>
<!-- Icône Marsel — même marque (mw-dot) que app.html (splash/auth) : cercle
     orange #E84315 + éclair blanc, chemin SVG repris à l'identique. Mise à
     l'échelle x3 et centrée (translate 21,21) pour tenir dans la zone de
     sécurité (66dp) du canevas adaptatif 108dp — le contenu original est un
     viewBox 22x22, donc 22*3=66 et (108-66)/2=21. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="21"
        android:translateY="21"
        android:scaleX="3"
        android:scaleY="3">
        <path
            android:fillColor="#E84315"
            android:pathData="M11,11 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12.5 3.5L7.5 12h5l-2.5 6.5 8-9.5H13z" />
    </group>
</vector>
